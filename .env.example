# ---------------------------------------------------------------------------
# Copy to .env for local use, OR set these as environment variables on the
# Claude Code environment so they survive container restarts.
# .env is gitignored. NEVER commit real values — this repository is public.
# ---------------------------------------------------------------------------

# intervals.icu — Settings -> Developer Settings -> API Key
# Auth is HTTP Basic: username is the literal string API_KEY, password is this.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=i119853

# Garmin Connect — used by the `garmin` MCP server in .mcp.json
# Unofficial API. Prefer tokens over the password once the first login is done.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional: directory holding saved OAuth tokens. Once a login succeeds, these
# are written here and the password is no longer needed. Refresh token lasts
# roughly a year.
GARMINTOKENS=~/.garminconnect

# Hevy — fallback only, needs Hevy Pro. Settings -> Developer.
HEVY_API_KEY=
